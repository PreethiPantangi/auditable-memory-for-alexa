# --- Database ---
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# --- MCP server ---
PORT=8000
MCP_URL=http://localhost:8000/mcp
# Min 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_SERVICE_TOKEN=replace-with-generated-token

# --- LLM ---
OPENAI_API_KEY=sk-replace-me
MODEL=gpt-5.4-mini

# --- Demo auth (FastAPI) ---
ALLOWED_DEMO_USERS=demo_user
# Both min 32 chars. Use different generated values.
DEMO_ACCESS_PASSWORD=replace-with-generated-password
DEMO_SESSION_SECRET=replace-with-generated-secret